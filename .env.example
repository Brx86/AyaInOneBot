# AyaInOneBot 配置模板。复制为 .env 并填入真实值。
# .env 只放开发机（勿提交）：mise 构建时会由 tools/gensecrets 内嵌进二进制，
# 随 garble 混淆，服务器无需放置本文件。查找顺序：环境变量 > .env > 内嵌值。
# 各 bot 启动时缺少必填项会 panic 并被 supervisor 记录后重启。

B23_BOT_TOKEN=123456:AA...
TELEGRAPH_TOKEN=...
FWD_BOT_TOKEN=123456:AA...
GEMINI_API_KEY=...
GAL_BOT_TOKEN=123456:AA...
DEEPSEEK_API_KEY=sk-...
GUN_BOT_TOKEN=123456:AA...
LEX_BOT_TOKEN=123456:AA...
INPUT_BOT_TOKEN=123456:AA...
MORSE_BOT_TOKEN=123456:AA...
OMO_BOT_TOKEN=123456:AA...
QWEATHER_API_KEY=...
SLAY_BOT_TOKEN=123456:AA...
ZSSM_BOT_TOKEN=123456:AA...

# 可选：小红书 cookie
# XHS_COOKIE=webId=...; web_session=...;
